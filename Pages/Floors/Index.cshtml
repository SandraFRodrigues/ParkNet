@page
@model ParkNet.Pages.Floors.IndexModel

@{
    ViewData["Title"] = "Floors Index";
}

<h1>Floors</h1>

<p>
    <a asp-page="Create">Create New Floor</a>
</p>

<table></table> class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Floors[0].Number)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var floor in Model.Floors)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => floor.Number)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@floor.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@floor.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@floor.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
