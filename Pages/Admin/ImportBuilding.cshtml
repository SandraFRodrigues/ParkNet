@page
@model ParkNet.Pages.Admin.ImportBuildingModel


<h2>Importar Layout do Parque</h2>

<form method="post" class="mb-4">
    <div class="mb-3">
        <label asp-for="BuildingName" class="form-label"></label>
        <input asp-for="BuildingName" class="form-control" required />
        <span asp-validation-for="BuildingName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Layout" class="form-label"></label>
        <textarea asp-for="Layout" class="form-control" rows="10" required oninput="previewLayout()"></textarea>
        <span asp-validation-for="Layout" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary me-2">Importar</button>
    <button type="button" class="btn btn-secondary" onclick="clearLayout()">Limpar</button>
</form>

<div id="preview" class="preview-container d-none">
    <h4>Pré-visualização do Layout</h4>
    <div id="layoutPreviewContainer"></div>
</div>

@if (Model.Success.HasValue)
{
    if (Model.Success.Value)
    {
        <div class="alert alert-success mt-3">Parque importado com sucesso!</div>
    }
    else
    {
        <div class="alert alert-danger mt-3">Ocorreu um erro ao importar o parque.</div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewLayout() {
            const layoutText = document.getElementById("Layout").value.trim();
            const previewSection = document.getElementById("preview");
            const layoutPreview = document.getElementById("layoutPreviewContainer");
            layoutPreview.innerHTML = "";

            if (!layoutText) {
                previewSection.classList.add("d-none");
                return;
            }

            const floors = layoutText.split(/\n\s*\n/);

            floors.forEach((floorText, floorIndex) => {
                const floorDiv = document.createElement("div");

                const label = document.createElement("div");
                label.className = "floor-label fw-bold my-2";
                label.innerText = `Piso ${floorIndex}`;
                floorDiv.appendChild(label);

                const lines = floorText.split("\n");
                lines.forEach((line, rowIndex) => {
                    const rowDiv = document.createElement("div");
                    rowDiv.className = "slot-row d-flex";

                    [...line].forEach((char, colIndex) => {
                        const slot = document.createElement("div");
                        slot.classList.add("slot", "border", "text-center", "me-1", "mb-1", "p-1");

                        let tooltip = `Piso ${floorIndex} | Linha ${rowIndex + 1} | Coluna ${colIndex + 1} - `;

                        if (char.toUpperCase() === "C") {
                            slot.classList.add("car");
                            slot.innerText = "C";
                            slot.title = tooltip + "Carro";
                        } else if (char.toUpperCase() === "M") {
                            slot.classList.add("moto");
                            slot.innerText = "M";
                            slot.title = tooltip + "Moto";
                        } else {
                            slot.classList.add("empty");
                            slot.innerText = "•";
                            slot.title = tooltip + "Vazio";
                        }

                        rowDiv.appendChild(slot);
                    });

                    floorDiv.appendChild(rowDiv);
                });

                layoutPreview.appendChild(floorDiv);
            });

            previewSection.classList.remove("d-none");
        }

        function clearLayout() {
            document.getElementById("Layout").value = "";
            document.getElementById("preview").classList.add("d-none");
        }

        document.addEventListener("DOMContentLoaded", previewLayout);
    </script>
}
